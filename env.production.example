# GrabDocs Mobile App - Production Environment Variables
# Copy this file to .env.production and fill in your actual values
# Note: Most settings auto-detect based on __DEV__ flag, but you can override here

# Backend API URL (auto-detects to https://api.grabdocs.com in production)
# Override if needed:
# EXPO_PUBLIC_API_URL=https://api.grabdocs.com

# Environment (auto-detects to 'production' when not in __DEV__ mode)
# Override if needed:
# EXPO_PUBLIC_ENVIRONMENT=production

# App configuration
EXPO_PUBLIC_APP_NAME=GrabDocs Mobile
EXPO_PUBLIC_APP_VERSION=1.0.0

# Google OAuth Client IDs (Platform-specific)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=your-google-client-id-web
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=your-google-client-id-android
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=your-google-client-id-ios

# Dropbox App Key
EXPO_PUBLIC_DROPBOX_APP_KEY=your-dropbox-app-key

# Development URL (not used in production, but can be set for debugging)
# EXPO_PUBLIC_DEV_URL=http://localhost:8081
