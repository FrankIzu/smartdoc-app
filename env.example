# GrabDocs Mobile App Environment Variables
# Copy this file to .env and fill in your actual values

# Backend API URL (auto-detected based on __DEV__ flag)
# Development: http://192.168.1.7:5000 (local backend)
# Production: https://api.grabdocs.com (production backend)
# Override with custom URL if needed:
# EXPO_PUBLIC_API_URL=https://your-custom-backend-url.com

# Environment (auto-detected: development when __DEV__ is true, production otherwise)
# Override if needed:
# EXPO_PUBLIC_ENVIRONMENT=development

# App configuration
EXPO_PUBLIC_APP_NAME=GrabDocs Mobile
EXPO_PUBLIC_APP_VERSION=1.0.0

# Google OAuth Client IDs (Platform-specific)
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=your-google-client-id-web
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=your-google-client-id-android
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=your-google-client-id-ios
# Optional: override redirect URI (default production: grabdocs://auth/callback)
# Must match exactly what you add in Google Cloud Console → Credentials → Authorized redirect URIs.
# EXPO_PUBLIC_GOOGLE_REDIRECT_URI=grabdocs://auth/callback

# Dropbox App Key
EXPO_PUBLIC_DROPBOX_APP_KEY=your-dropbox-app-key

# Development URL (auto-detected based on __DEV__ flag)
# Override if needed:
# EXPO_PUBLIC_DEV_URL=http://your-custom-dev-server.com

# HMS (100ms) Configuration for Mobile
# Note: HMS credentials are managed by the backend (manager-francis/.env)
# Mobile app gets authentication tokens via backend API calls
# No direct HMS credentials needed in mobile .env file 