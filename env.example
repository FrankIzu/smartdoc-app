# GrabDocs Mobile App – .env
# Copy to .env and set your real values. For EAS Build, set these in eas.json "env" or EAS Secrets.

# ============== API ==============
# Backend URL. Auto-detected in code (localhost in dev, https://api.grabdocs.com in prod) unless you set this.
# EXPO_PUBLIC_API_URL=https://api.grabdocs.com

# ============== App ==============
EXPO_PUBLIC_APP_NAME=GrabDocs Mobile
EXPO_PUBLIC_APP_VERSION=1.0.0
# EXPO_PUBLIC_ENVIRONMENT=development

# ============== Google OAuth (required for “Sign in with Google”) ==============
# Use the same Web client ID for all if you have one; or separate IDs per platform.
# In Google Console this client must have: https://api.grabdocs.com/api/v1/web/auth/callback
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=your-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=your-client-id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=your-client-id.apps.googleusercontent.com
# Optional: single fallback (used if platform-specific is empty)
# EXPO_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# Optional: override redirect URI (app default: https://api.grabdocs.com/api/v1/web/auth/callback for native)
# EXPO_PUBLIC_GOOGLE_REDIRECT_URI=https://api.grabdocs.com/api/v1/web/auth/callback

# ============== Apple Sign In (iOS) ==============
# EXPO_PUBLIC_APPLE_CLIENT_ID=com.grabdocs.mobile.service

# ============== Dropbox ==============
EXPO_PUBLIC_DROPBOX_APP_KEY=your-dropbox-app-key

# ============== Optional ==============
# EXPO_PUBLIC_FRONTEND_URL=https://app.grabdocs.com
# EXPO_PUBLIC_DEV_URL=http://192.168.1.5:8081
