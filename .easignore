env.example
env.production.example
.env.production.template
cookies.txt
background_reprocessor.log

# Git
.git
.gitignore

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.aab
*.apk

# Large files and directories
dev-files/
grabdocs/
scripts/
utils/
hooks/
types/
stores/
%USERPROFILE%/
