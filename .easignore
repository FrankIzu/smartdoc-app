# EAS Build Ignore File
# Exclude unnecessary files to reduce build size and upload time

# DO NOT ignore index.js - it's the entry point!
!index.js

# Keep android folder to use our custom Gradle config that fixes entry point resolution
# /android

# Dependencies (EAS runs npm install on server - don't upload)
node_modules/

# Development files
node_modules/.cache
.expo
dist
dist_expo
web-build

# Python virtual env (often 200-500MB)
venv/
.venv/

# Documentation
*.md
docs/
README.md
ENVIRONMENT_SETUP.md
OAUTH_DEPLOYMENT_GUIDE.md
OAUTH_INTEGRATION_STATUS.md
GOOGLE_OAUTH_FIX.md
GOOGLE_OAUTH_SETUP.md
ENHANCED_2FA_IMPLEMENTATION.md
EXTERNAL_FILE_UPLOAD_IMPLEMENTATION.md
HMS_INTEGRATION_GUIDE.md
MOBILE_HMS_WEBHOOK_INTEGRATION_SUMMARY.md
MOBILE_OTP_IMPLEMENTATION.md
PLAY_STORE_LISTING.md
POST_LAUNCH_CHECKLIST.md
RELEASE_NOTES_v1.0.0.md
SETTINGS_IMPLEMENTATION_STATUS.md
SUBMISSION_CHECKLIST.md
USER_GUIDE.md
ACCOUNT_MIGRATION_GUIDE.md

# Test files and coverage (can be 100MB+)
test-*
*_test.*
__tests__/
*.test.*
test-files/
coverage/
.nyc_output/

# Logs
*.log
logs/

# Backup files
*.backup
app-backup/
_project_cleanup/

# Data directories
data/
uploads/
processed/
extracted_metadata/
francis/
recordings/
templates/
transcripts/
user_2/

# Python files (not needed for mobile build)
*.py
manager-francis/
# Allow brand images from manager-francis to be included
!manager-francis/frontend/public/cdn-site/grabdocs-brand/
db_scripts/
check_*.py
debug_*.py
reupload_*.py
test_*.py

# Other development files
.env.example
env.example
env.production.example
.env.production.template
cookies.txt
background_reprocessor.log

# Git
.git
.gitignore

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
*.aab
*.apk
*.ipa

# Build artifacts and extracted content (often 100MB+)
ipa-extract/
build.zip
build.ipa
android/app/build
android/build
ios/build

# Large files and directories
dev-files/
%USERPROFILE%/

# Archives and packages
*.tar.gz
*.zip
*.tgz

# Do NOT ignore ios/ or android/ when using prebuild in CI (build-ios.yml, build-android.yml).
# If ignored, EAS re-runs prebuild and uses remote stored version (e.g. buildNumber 51, versionCode 51)
# instead of app.versions.json. That causes "already submitted this build/version" on store submit.
# ios/
# android/
