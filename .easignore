PLAY_STORE_LISTING.md
POST_LAUNCH_CHECKLIST.md
RELEASE_NOTES_v1.0.0.md
SETTINGS_IMPLEMENTATION_STATUS.md
SUBMISSION_CHECKLIST.md
USER_GUIDE.md
ACCOUNT_MIGRATION_GUIDE.md

# Test files
test-*
*_test.*
__tests__/
*.test.*
test-files/

# Logs
*.log
logs/

# Backup files
*.backup
app-backup/
_project_cleanup/

# Data directories
data/
uploads/
processed/
