# GrabDocs Mobile App - Production Environment Variables
# Copy this content to .env.production file

# Backend API URL (auto-detects to https://api.grabdocs.com in production)
# The app will automatically use https://api.grabdocs.com when not in __DEV__ mode
# You can override if needed:
# EXPO_PUBLIC_API_URL=https://api.grabdocs.com

# Environment (auto-detects to 'production' when not in __DEV__ mode)
# The app automatically detects production mode during EAS builds
# You can override if needed:
# EXPO_PUBLIC_ENVIRONMENT=production

# App configuration
EXPO_PUBLIC_APP_NAME=GrabDocs Mobile
EXPO_PUBLIC_APP_VERSION=1.0.0

# Google OAuth Client IDs (Platform-specific)
# IMPORTANT: These should match your Google Cloud Console OAuth clients
# The backend uses the same GOOGLE_CLIENT_ID and GOOGLE_CLIENT_SECRET from Render
# But the mobile app needs platform-specific client IDs for OAuth flow
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=388172995920-thao2b2ssslc63hhmbcpmcjailnfcbba.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=388172995920-thao2b2ssslc63hhmbcpmcjailnfcbba.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=388172995920-thao2b2ssslc63hhmbcpmcjailnfcbba.apps.googleusercontent.com

# Dropbox App Key
# IMPORTANT: This should match your Dropbox app configuration
# The backend uses DROPBOX_APP_KEY and DROPBOX_APP_SECRET from Render
# But the mobile app needs the app key for OAuth flow
EXPO_PUBLIC_DROPBOX_APP_KEY=hmlhlh1h44gtth0

# Development URL (not used in production, but can be set for debugging)
# EXPO_PUBLIC_DEV_URL=http://localhost:8081

# Note: HMS (100ms) Configuration is managed by the backend
# The mobile app gets authentication tokens via backend API calls
# No direct HMS credentials needed in mobile .env file
