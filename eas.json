{
  "cli": {
    "version": ">= 5.9.1",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_ENVIRONMENT": "development"
      },
      "ios": {
        "resourceClass": "m-medium"
      }
    },
    "preview": {
      "distribution": "store",
      "env": {
        "EXPO_PUBLIC_ENVIRONMENT": "staging"
      },
      "ios": {
        "resourceClass": "m-medium"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "env": {
        "EXPO_PUBLIC_ENVIRONMENT": "production",
        "NODE_ENV": "production"
      },
      "ios": {
        "resourceClass": "m-medium",
        "distribution": "store",
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "app-bundle",
        "distribution": "store"
      }
    },
    "minimal": {
      "env": {
        "EXPO_PUBLIC_ENVIRONMENT": "production",
        "NODE_ENV": "production"
      },
      "ios": {
        "resourceClass": "m-medium",
        "distribution": "store"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "test": {
      "env": {
        "EXPO_PUBLIC_ENVIRONMENT": "production",
        "NODE_ENV": "development"
      },
      "ios": {
        "resourceClass": "m-medium",
        "distribution": "store"
      }
    },
    "simple": {
      "env": {
        "EXPO_PUBLIC_ENVIRONMENT": "production"
      },
      "ios": {
        "resourceClass": "m-medium",
        "distribution": "store"
      }
    }
  },
  "submit": {
